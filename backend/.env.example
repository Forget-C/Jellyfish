# Jellyfish Backend - 环境变量示例
# 复制为 .env 后按需修改

# 应用
APP_NAME=Jellyfish API
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# 数据库（默认 SQLite 异步）
# DATABASE_URL=sqlite+aiosqlite:///./jellyfish.db
# PostgreSQL 示例:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/jellyfish
# MySQL 示例（使用 aiomysql 驱动）:
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/jellyfish

# Redis / Celery Broker
# 默认情况下，若未单独指定 CELERY_BROKER_URL，系统会自动使用以下 Redis 配置拼接：
# redis://[:password@]host:port/db
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# 如需单独覆盖，可直接指定完整 broker URL：
# CELERY_BROKER_URL=redis://localhost:6379/0

# CORS 前端地址（逗号分隔）
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 图片生成（用于演员/角色/道具/场景/服装/镜头帧图片生成任务）
# IMAGE_API_PROVIDER=openai
# IMAGE_API_BASE_URL=https://example.com/v1/images/generations
# IMAGE_API_KEY=your-image-api-key

# 视频生成（用于 /film/generated_video 等接口）
# VIDEO_API_PROVIDER=openai
# VIDEO_API_BASE_URL=https://example.com/v1/videos/generations
# VIDEO_API_KEY=your-video-api-key

# ---------------------------------------------------------------------------
# 演练 / 真实模式（付费出口守卫）
#
# 这两个开关写在**本文件里也生效**（守卫会读 pydantic-settings 解析出来的 Settings）。
# 解析优先级：**进程环境变量 > backend/.env > 默认值**，也就是
#   - 两处都没写    → 演练模式（默认，零费用）；
#   - 只有 .env 写了 → 按 .env 生效，**后端启动时会打一条醒目中文告警**（怕它悄悄开出去）；
#   - 环境变量也写了 → 以环境变量为准（可以临时压掉 .env）。
# 取值读不懂（例如 JELLYFISH_DRY_RUN=maybe）一律按演练处理（fail-safe）。
#
# ⚠️ 默认请**保持注释掉**。要临时开真实模式，更推荐在启动后端的终端里 export：
#
#   # 在启动后端的同一个终端里
#   export JELLYFISH_DRY_RUN=0
#   export JELLYFISH_REAL_LLM_CONFIRMED=1
#   uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
#
# 或者用仓库脚本（带二次确认与模式回显）：
#   bash backend/scripts/run_backend.sh            # 演练模式（默认，零费用）
#   bash backend/scripts/run_backend.sh --real     # 真实模式（需确认）
#
# 确认当前模式：GET /api/v1/studio/llm/orchestration/status
# （看 data.mode 与 data.switch_source / data.dotenv_real_mode），或页面右上角角标。
# 完整说明见 docs/real-run-mode.md。
# ---------------------------------------------------------------------------
# JELLYFISH_DRY_RUN=0
# JELLYFISH_REAL_LLM_CONFIRMED=1

# S3 / 对象存储（素材文件）
# 如使用 AWS S3，可按需填写：
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_REGION_NAME=ap-southeast-1
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=jellyfish-assets
# 可选统一前缀，方便按环境/项目隔离，如 jellyfish/dev
# S3_BASE_PATH=jellyfish/dev
# 若有 CDN/自定义域名，可配置成 https://cdn.example.com
# S3_PUBLIC_BASE_URL=

# Jellyfish Backend 本地调试配置
#
# 与 deploy/compose/.env.example 的默认中间件配置保持一致。先启动：
# docker compose --env-file deploy/compose/.env -f deploy/compose/docker-compose.yml \
#   up -d mysql redis rustfs
#
# 如修改了 deploy/compose/.env 中的 MySQL 或 RustFS 凭据，请同步修改这里。

# MySQL（Compose 映射到宿主机 3306 端口）
DATABASE_URL=mysql+aiomysql://jellyfish:change-me@127.0.0.1:3306/jellyfish

# Redis / Celery Broker（Compose 默认未启用认证）
# 未设置 CELERY_BROKER_URL 时，应用会根据以下配置生成 broker 地址。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Vite 本地开发服务器地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RustFS（S3 compatible，Compose 映射到宿主机 9000 端口）
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET_NAME=jellyfish-assets
